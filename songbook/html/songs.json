    "capo": null,
    "content": "<div class=\"cp-header\">\n<div class=\"cp-title\">Klidná jako voda</div>\n<div class=\"cp-artist\">Jelen</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"intro\">\n<div class=\"cp-section-label\">Intro</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">&nbsp;</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"verse\">\n<div class=\"cp-section-label\">Verse</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> Chodím světem už </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">pěknejch pár </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">let</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> parným létem i </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">zrmzlej jak </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">led</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> zjistil jsem, že </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">lásku smím </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">dávat i </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">vzít</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">nikdy jsem </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">nešel tou </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">cestou, kudy </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">ty musíš </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">jít</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"verse\">\n<div class=\"cp-section-label\">Verse</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> Viděl jsem i místa, lep</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">ší zapome</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">nout</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> kulky vzduchem hvízdat, těla </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">po vodě </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">plout</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> někdy si až </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">říkám, jestli </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">mám právo </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">žít</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">a to jsem </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">nešel tou </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">cestou, kudy </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">ty musíš </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">jít</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"chorus\">\n<div class=\"cp-section-label\">Chorus</div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">Buď </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">klidná jako </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">voda, ale </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">silná jako </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">proud</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">skála se ti pod</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">dá a </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">zbavíš se všech pout</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">svěží jako ranní </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">rosa a </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"E7\">E7</span><span class=\"cp-lyric\">čistá jako </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\">sníh</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">když tan</span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">číš po kamení </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">bosá, </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">svět máš na dla</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">ních</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"verse\">\n<div class=\"cp-section-label\">Verse</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> Život někdy umí lidem </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">naložit </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">kříž</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> ale ničeho se neboj, jsem tu s </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">tebou, vždyť </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">víš</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> a i kdyby nás </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">ďábel chtěl </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">na rohy </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">vzít</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">spolu </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">půjdem tou </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">cestou, kudy </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">ty musíš </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">jít</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-chorus-ref\"></div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"outro\">\n<div class=\"cp-section-label\">Outro</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">Svěží jako ranní </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">rosa a </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"E7\">E7</span><span class=\"cp-lyric\">čistá jako </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\">sníh</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">když tan</span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"F\">F</span><span class=\"cp-lyric\">číš po kamení </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">bosá, </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\">svět máš na dla</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">ních</span></span></div>\n</div>\n<div class=\"cp-break\"></div>"
