    "capo": null,
    "content": "<div class=\"cp-header\">\n<div class=\"cp-title\">Dinosaur</div>\n<div class=\"cp-artist\">Kruh 19</div>\n<div class=\"cp-meta\">Key: Am</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"intro\">\n<div class=\"cp-section-label\">Intro</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> </span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"verse\">\n<div class=\"cp-section-label\">Verse</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\"> Podívej se brácho na tohohle </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">sejčka.</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">Nepřemejšlim jako malej, jak dělá </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">liška.</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">Všichni se mě </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\">ptaj, co dělá </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">vejška.</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\"> Nikoho už nezajímá oblíbená </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">knížka (ani film),</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">oni mě soudí podle </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">toho, jestli dávám </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\">dýška (možná </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">ne).</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"chorus\">\n<div class=\"cp-section-label\">Chorus</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> Dlouho se mě nikdo </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">nezeptal,</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">jakej je </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\">můj oblíbenej </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">dinosaur. (nezeptal)</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> Dlouho se mě nikdo </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">nezeptal,</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">je to stego</span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\">saur, je to stego</span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">saur.</span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"interlude\">\n<div class=\"cp-section-label\">Vyhrávka</div>\n<div class=\"cp-comment\">Vyhrávka</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> </span></span></div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"verse\">\n<div class=\"cp-section-label\">Verse</div>\n<div class=\"cp-lyric-line\">Pamatuješ Káti, jezdili jsme rádi</div>\n<div class=\"cp-lyric-line\">na plastový motorce, teď to nejde do vzorce,</div>\n<div class=\"cp-lyric-line\">ty pracuješ v laborce.</div>\n<div class=\"cp-lyric-line\">A už je to dávno, co bylo lehký táhnout,</div>\n<div class=\"cp-lyric-line\">za jeden konec, nám odzvonil zvonec,</div>\n<div class=\"cp-lyric-line\">už to nejde zvládnout.</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"chorus\">\n<div class=\"cp-section-label\">Chorus</div>\n<div class=\"cp-lyric-line\">Dlouho se mě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je můj oblíbenej dinosaur. (nezeptal)</div>\n<div class=\"cp-lyric-line\">Dlouho se mě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">je to stegosaur, je to stegosaur.</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-lyric-line\">Dlouho se tě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je tvůj oblíbenej dinosaur. (nezeptal)</div>\n<div class=\"cp-lyric-line\">Dlouho se tě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je to saur, jakej je to saur.</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"bridge\">\n<div class=\"cp-section-label\">Bridge</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"G\">G</span><span class=\"cp-lyric\"> Ňákej pán mi řek: vy už nejste </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">děti,</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">už nejste děti, vy už nejste </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">děti.</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-lyric-only\">Ty si na to </span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\">káp, už nejsme </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">děti...</span></span></div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-lyric-line\">Občas se sám ptám, proč už nejsme děti,</div>\n<div class=\"cp-lyric-line\">proč nejsme děti, proč už nejsme děti.</div>\n<div class=\"cp-lyric-line\">Ty si na to káp, už nejsme děti...</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"chorus\">\n<div class=\"cp-section-label\">Chorus</div>\n<div class=\"cp-lyric-line\">Dlouho se mě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je můj oblíbenej dinosaur. (nezeptal)</div>\n<div class=\"cp-lyric-line\">Dlouho se mě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">je to stegosaur, je to stegosaur.</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-lyric-line\">Dlouho se tě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je tvůj oblíbenej dinosaur. (nezeptal)</div>\n<div class=\"cp-lyric-line\">Dlouho se tě nikdo nezeptal,</div>\n<div class=\"cp-lyric-line\">jakej je to saur, jakej je to saur.</div>\n</div>\n<div class=\"cp-break\"></div>\n<div class=\"cp-section\" data-section=\"outro\">\n<div class=\"cp-section-label\">Outro</div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\"> Jakej je to saur</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">&nbsp;</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> Dlouho se tě </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\">nezeptal</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\"> Nikdo se tě </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">nezeptal</span></span></div>\n<div class=\"cp-line\"><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Am\">Am</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Em\">Em</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"Bm\">Bm</span><span class=\"cp-lyric\"> </span></span><span class=\"cp-unit\"><span class=\"cp-chord\" data-chord=\"C\">C</span><span class=\"cp-lyric\">&nbsp;</span></span></div>\n</div>\n<div class=\"cp-break\"></div>"
